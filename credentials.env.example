# Hetzner Cloud API credentials and monitor targets
HETZNER_API_TOKEN=
HETZNER_SERVER_TYPES=CAX21,CAX31
HETZNER_LOCATIONS=fsn,nbg

# AWS SES credentials and delivery settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
SES_FROM_EMAIL=
SES_RECIPIENT_EMAIL=receipient@example.com

# Polling and diagnostics
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15
LOG_LEVEL=debug
